# ---- Core ----
DATABASE_URL=postgres://lumi:lumi@localhost:5433/lumi
LUMI_PUBLIC_URL=http://localhost:3000        # set to your ngrok static domain for webhooks/Slack
LUMI_DATA_DIR=./data                         # videos, audio, screenshots (expire after retention days)
LUMI_RETENTION_DAYS=30
LUMI_API_KEY=                                # key agents use with @lumi/sdk (generate: openssl rand -hex 24)
LUMI_DEMO_NOW=                               # optional ISO date that pins "today" for the demo

# ---- GitHub App (written by `pnpm setup:github-app`) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LUMI_DEMO_REPO=adityas0405/lumi-demo-checkout
LUMI_ALLOWED_LOGINS=adityas0405               # comma-separated GitHub logins allowed to sign in

# ---- LLM provider (triage, narration scripts, Q&A) ----
LUMI_LLM_PROVIDER=claude-code                # claude-code (local only, your Claude login) | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model overrides; blank = provider default (claude-code: Sonnet 5.5 everywhere, Opus 5.5 as fallback)
LUMI_MODEL_TRIAGE=
LUMI_MODEL_STORY=
LUMI_MODEL_QA=

# ---- Claude (optional; used when LUMI_LLM_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=

# ---- Voice ----
LUMI_TTS_PROVIDER=elevenlabs                 # elevenlabs | kokoro | cartesia
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
KOKORO_URL=http://localhost:8880

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#lumi-alerts

# ---- ngrok ----
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ---- Stretch: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LUMI_ONCALL_PHONE=

# ---- Web app ----
LUMI_SESSION_SECRET=                         # openssl rand -hex 32
LUMI_DEV_AUTH=                               # local-only sign-in bypass for browser tests
LUMI_WEBHOOK_TOKEN=                          # for /api/incidents/sentry|datadog?token=...
LUMI_SIMULATE_FIXTURE=demo/incidents/checkout-zone-crash.json
SENTRY_CLIENT_SECRET=                        # optional: verify Sentry webhook signatures
