{
  "name": "lumi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @lumi/db generate",
    "db:migrate": "pnpm --filter @lumi/db migrate",
    "setup:github-app": "tsx scripts/setup-github-app.ts",
    "demo:reset": "tsx --env-file=.env demo/replay.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "octokit": "^5.0.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
